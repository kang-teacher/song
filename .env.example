# 모두 선택 사항입니다. 키는 웹사이트 왼쪽 칸에서 직접 입력해도 됩니다.
# 여기에 넣을 때는 이 파일을 .env.local로 복사해서 쓰세요 (이 파일에는 키를 넣지 마세요).

# 가사 생성 (Claude API) - https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=
# 선택: 가사 생성 모델 (기본값 claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# 노래 생성 (sunoapi.org) - https://sunoapi.org 에서 발급
SUNO_API_KEY=
# 선택: API 주소와 모델 버전
# SUNO_API_BASE=https://api.sunoapi.org
# SUNO_MODEL=V4_5

# 선택: 수업 코드. 값을 넣으면 학생이 이 코드를 입력해야 가사/노래를 만들 수 있습니다.
# (사이트 주소가 외부에 알려져 API 사용량이 새는 것을 막아줍니다)
# CLASS_CODE=
